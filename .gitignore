# Files generated by scripts/setup-machine.sh: they depend on each machine's
# monitors, so they do not belong in the shared repo.
noctalia/.config/noctalia/90-monitors.local.toml

# easyeffects UI state: current input and output device and preset usage
# counters, rewritten on every start. The real presets live in
# .local/share/easyeffects/, and the right preset for the DAC is applied by
# autoload/. The file stays in the repo so that stow links it, but it stops
# cluttering the diffs.
easyeffects/.config/easyeffects/db/easyeffectsrc

# Monitor layout, written by nwg-displays: it depends on the attached screens
# and on the connectors the kernel assigns (the same monitor was DP-2 and then
# DP-3). config.kdl includes it, so on a new machine setup-machine.sh creates
# an empty one: without the file the include fails.
# Hand tweaks live in outputs.local.kdl, which niri merges with this one.
niri/.config/niri/monitor.kdl
niri/.config/niri/monitor.kdl.bak

# Backups that noctalia writes next to its own config when it rewrites it.
# One of these ended up committed and, finding the twin on disk, blocked the
# whole stow of the package: templates/ and palettes/ stayed unlinked.
noctalia/.config/noctalia/*.bak-*

# Personal noctalia settings (avatar, wallpaper, paths): they depend on the home directory.
noctalia/.config/noctalia/91-user.local.toml

# Hand-written monitor tweaks of this machine (focus-at-startup...). See
# outputs.local.kdl.example; setup-machine.sh creates an empty one.
niri/.config/niri/outputs.local.kdl

# Backups left next to config.kdl when it gets rewritten, same story as the
# noctalia ones: a committed copy would block the stow of the whole package.
niri/.config/niri/*.bak-*
