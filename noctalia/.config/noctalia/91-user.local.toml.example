# Copy to ~/.config/noctalia/91-user.local.toml (it does not go in the repo)
# and adapt it: the paths depend on your home.

[shell]
# avatar_path = "/home/YOUR_USER/Immagini/avatar.png"

[wallpaper.default]
# path = "/home/YOUR_USER/Immagini/sfondo.jpg"

# The single terminal: instead of opening a new kitty, it creates a tmux
# session in the one already open and focuses it.
[plugin_settings."yuuto/arch-updater"]
terminal = "/home/YOUR_USER/.config/niri/terminal.sh run"

# Optional: an Obsidian vault outside $HOME (the community template only finds
# vaults under $HOME). Renders the repo's templates/obsidian.css into it.
# [theme.templates.user.obsidian]
# input_path = "$XDG_CONFIG_HOME/noctalia/templates/obsidian.css"
# output_path = "/path/to/vault/.obsidian/snippets/noctalia.css"
