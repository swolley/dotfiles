#!/usr/bin/env bash
# accent-sync — propagate the accent color to the hand-written files.
#
# The color source is the noctalia palette: from there the templates
# regenerate GTK, niri, Qt, bat, fzf, lazygit and the rest on their own.
# Five files remain, however, with the hex value written inside, because
# they are customized and the templates would overwrite them. This script
# keeps them in sync.
#
# The accent in use is read from kitty.conf (color2), which acts as the
# anchor: every occurrence of that value in the five files is replaced.
#
# Usage:
#   ./scripts/accent-sync                 # take the accent from the palette
#   ./scripts/accent-sync '#7fb069'       # use the given color
#   ./scripts/accent-sync --dry-run       # show what would change
#   ./scripts/accent-sync --check         # exit 1 if anything is out of sync

set -euo pipefail

RED="\033[1;31m"; GREEN="\033[1;32m"; YELLOW="\033[1;33m"
BLUE="\033[1;34m"; CYAN="\033[1;36m"; DIM="\033[2m"; RESET="\033[0m"

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PALETTE="$REPO_DIR/noctalia/.config/noctalia/palettes/adwaita-starship.json"
ANCORA="$REPO_DIR/kitty/.config/kitty/kitty.conf"

# Files the templates don't touch, which therefore stay our responsibility.
FILES=(
  "kitty/.config/kitty/kitty.conf"
  "tmux/.tmux.conf"
  "gitmux/.gitmux.conf"
  "starship/.config/starship/palette-default.toml"
  "nvim/.config/nvim/lua/noctalia/palette.lua"
)

DRY_RUN=0
CHECK=0
NUOVO=""

section() { echo -e "\n${CYAN}==>${RESET} ${BLUE}$1${RESET}"; }
info()    { echo -e "    $*"; }
ok()      { echo -e "    ${GREEN}ok${RESET} $*"; }
warn()    { echo -e "    ${YELLOW}warning${RESET} $*"; }
die()     { echo -e "${RED}error:${RESET} $*" >&2; exit 1; }

usage() { sed -n '2,19p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run|-n) DRY_RUN=1 ;;
    --check)      CHECK=1; DRY_RUN=1 ;;
    --help|-h)    usage ;;
    -*)           die "unknown option: $1" ;;
    *)            NUOVO="$1" ;;
  esac
  shift
done

[ -f "$ANCORA" ] || die "missing $ANCORA"

# Accent currently written in the files: kitty's color2.
VECCHIO="$(awk '/^color2[[:space:]]/ { print $2; exit }' "$ANCORA")"
[ -n "$VECCHIO" ] || die "color2 not found in $ANCORA"

# Target accent: the argument, otherwise the noctalia palette.
if [ -z "$NUOVO" ]; then
  [ -f "$PALETTE" ] || die "missing $PALETTE: pass the color as an argument"
  NUOVO="$(python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
print((d.get("dark") or d)["mPrimary"])' "$PALETTE")"
fi

case "$NUOVO" in
  '#'[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
  *) die "invalid color: $NUOVO (expected #rrggbb)" ;;
esac

section "Accent"
info "in files:   $VECCHIO   (from $(basename "$ANCORA"), color2)"
info "requested:  $NUOVO"

if [ "$VECCHIO" = "$NUOVO" ]; then
  ok "already in sync, nothing to do"
  exit 0
fi

section "Files"
TOCCATI=0
for f in "${FILES[@]}"; do
  percorso="$REPO_DIR/$f"
  if [ ! -f "$percorso" ]; then
    warn "$f does not exist, skipping"
    continue
  fi
  n="$(grep -c -i -- "$VECCHIO" "$percorso" || true)"
  if [ "$n" -eq 0 ]; then
    warn "$f does not contain the accent"
    continue
  fi
  TOCCATI=$((TOCCATI + n))
  info "$f ${DIM}($n occurrences)${RESET}"
  [ "$DRY_RUN" -eq 1 ] && continue
  # sed -i would replace the symlink with a regular file, detaching it from
  # the stowed copy: rewrite the contents through the symlink instead.
  tmp="$(mktemp)"
  sed "s/$VECCHIO/$NUOVO/gI" "$percorso" >"$tmp"
  cat "$tmp" >"$percorso"
  rm -f "$tmp"
done

if [ "$CHECK" -eq 1 ]; then
  [ "$TOCCATI" -eq 0 ] && { ok "everything in sync"; exit 0; }
  die "$TOCCATI occurrences to update: run ./scripts/accent-sync"
fi

section "Done"
if [ "$DRY_RUN" -eq 1 ]; then
  info "no changes written (--dry-run)"
else
  ok "$TOCCATI occurrences changed to $NUOVO"
  info "files regenerated from templates follow the noctalia palette:"
  info "${DIM}noctalia msg templates-apply${RESET}"
fi
