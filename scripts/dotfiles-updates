#!/bin/sh
# Sends a notification if the dotfiles repo has commits to pull.
# Runs at login (spawn-at-startup in niri), waits for the network and fetches.
# Changes nothing: no pull. If the fetch fails (no network, ssh key not
# unlocked) it exits without notifying.
REPO="${DOTFILES:-$HOME/.dotfiles}"
export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10"

cd "$REPO" || exit 0

# the network may come up after login: retry for about 2 minutes
ok=0
for _ in 1 2 3 4 5 6 7 8; do
  if git fetch --quiet 2>/dev/null; then ok=1; break; fi
  sleep 15
done
[ "$ok" = 1 ] || exit 0

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
upstream=$(git rev-parse --abbrev-ref "$branch@{upstream}" 2>/dev/null) || exit 0
behind=$(git rev-list --count "HEAD..$upstream")
[ "$behind" -gt 0 ] || exit 0

ahead=$(git rev-list --count "$upstream..HEAD")
body=$(git log --format='%s' -5 "HEAD..$upstream")
[ "$ahead" -gt 0 ] && body="$body
(you also have $ahead local unpushed commits: a rebase is needed)"
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  body="$body
(uncommitted local changes)"
fi

# the notification daemon is noctalia, which starts in parallel with this
# script: without it the notification would be lost. Wait up to 60 seconds.
for _ in $(seq 60); do
  busctl --user status org.freedesktop.Notifications >/dev/null 2>&1 && break
  sleep 1
done

notify-send -a dotfiles -i software-update-available \
  "Dotfiles: $behind commits to pull" "$body

cd ~/.dotfiles && git pull --rebase"
