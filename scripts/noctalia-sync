#!/usr/bin/env python3
"""Move noctalia settings made through the UI into the dotfiles.

The shell always writes to ~/.local/state/noctalia/settings.toml, which takes
precedence over the shared config.toml. This script moves the portable blocks
into the repo and leaves only the machine-specific ones in the state file.

Usage:
  noctalia-sync            show what it would move and ask for confirmation
  noctalia-sync --dry-run  show only
  noctalia-sync --yes      move without asking
"""
import re
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

STATE = Path.home() / ".local/state/noctalia/settings.toml"
SHARED = Path.home() / ".config/noctalia/config.toml"

# Blocks that stay local: monitor names, geometries computed from the
# resolution, current wallpapers, per-plugin settings containing paths.
LOCAL = [
    re.compile(r"^\s*\[bar\.[a-z_]+\.monitor\."),
    re.compile(r"^\s*\[dock\.monitor\."),
    re.compile(r"^\s*\[lockscreen_widgets"),
    re.compile(r"^\s*\[notification\]"),
    re.compile(r"^\s*\[osd\]"),
    re.compile(r"^\s*\[wallpaper\.(last|monitors)"),
]
# Keys that stay local even inside a portable block: the row of icons pinned
# to the dock depends on what is installed on this machine, while the rest of
# [dock] (size, behavior) is shared.
LOCAL_KEYS = {
    "[dock]": {"pinned"},
}
HEADER = re.compile(r"^\s*\[")


def blocks(text):
    """Split a TOML into (preamble, [(header, lines), ...])."""
    pre, out, cur = [], [], None
    for line in text.split("\n"):
        if HEADER.match(line):
            if cur:
                out.append(cur)
            cur = [line]
        elif cur is None:
            pre.append(line)
        else:
            cur.append(line)
    if cur:
        out.append(cur)
    return pre, [(b[0].strip(), b) for b in out]


def render(bs):
    out = []
    for _, b in bs:
        b = list(b)
        while b and not b[-1].strip():
            b.pop()
        out += b + [""]
    return "\n".join(out).rstrip("\n") + "\n"


KEY = re.compile(r"^\s*([A-Za-z0-9_.\"'-]+)\s*=")


def voci(blocco):
    """Split the body of a block into entries (key, lines).

    Comments and blank lines attach to the key that follows them, so a
    replaced key brings its own comment along. Keys whose value spans several
    lines (arrays) are recognized by counting the brackets still open.
    """
    out, buf, sospese, chiave, aperte = [], [], [], None, 0
    for riga in blocco[1:]:
        commento = riga.lstrip().startswith("#")
        if aperte == 0 and (commento or not riga.strip()):
            sospese.append(riga)
            continue
        if aperte == 0 and KEY.match(riga):
            if buf:
                out.append((chiave, buf))
            buf, chiave = sospese + [riga], KEY.match(riga).group(1)
        else:
            buf += sospese + [riga]
        sospese = []
        if not commento:
            aperte += riga.count("[") - riga.count("]")
    if buf:
        out.append((chiave, buf))
    if sospese:
        out.append((None, sospese))
    return out


def rientra(righe, da, a):
    """Re-indent a block of lines from indentation `da` to `a`.

    The state file writes nested tables without indentation, while the repo
    keeps them indented: without this every sync would flatten the file.
    """
    if da == a:
        return righe
    return [a + r[len(da):] if r.startswith(da) else r for r in righe]


def spazi(riga):
    return riga[: len(riga) - len(riga.lstrip())]


def unisci(repo, stato):
    """Merge a repo block with its namesake from the state file.

    The state wins on the keys it defines, but keys present only in the repo
    must be preserved: replacing the whole block would lose them and the
    effective configuration would change.
    """
    da_stato = {k: righe for k, righe in voci(stato) if k is not None}
    fuso, usate = [repo[0]], set()
    for k, righe in voci(repo):
        if k is not None and k in da_stato:
            fuso += rientra(da_stato[k], spazi(da_stato[k][0]), spazi(righe[0]))
            usate.add(k)
        else:
            fuso += righe
    for k, righe in voci(stato):
        if k is not None and k not in usate:
            fuso += righe
    return fuso


def separa(header, blocco):
    """Split a block into (to move, to leave in the state file).

    Needed for blocks that are shared for almost everything except a few keys:
    those listed in LOCAL_KEYS stay where the shell wrote them.
    """
    locali = LOCAL_KEYS.get(header)
    if not locali:
        return blocco, None
    tieni, sposta = [blocco[0]], [blocco[0]]
    for k, righe in voci(blocco):
        (tieni if k in locali else sposta).extend(righe)
    return (sposta if len(sposta) > 1 else None,
            tieni if len(tieni) > 1 else None)


def main():
    args = sys.argv[1:]
    dry = "--dry-run" in args or "-n" in args
    assume_yes = "--yes" in args or "-y" in args

    for f in (STATE, SHARED):
        if not f.exists():
            sys.exit(f"missing {f}")
    if ".dotfiles" not in SHARED.resolve().parts:
        print(f"note: {SHARED} does not resolve into the dotfiles", file=sys.stderr)

    pre_state, st_blocks = blocks(STATE.read_text())
    pre_shared, sh_blocks = blocks(SHARED.read_text())

    movable, trattenuti = [], []
    for h, b in st_blocks:
        if any(p.match(h) for p in LOCAL):
            continue
        sposta, tieni = separa(h, b)
        if sposta:
            movable.append((h, sposta))
        if tieni:
            trattenuti.append((h, tieni))
    if not movable:
        print("nothing to move: the state file only contains settings specific to this machine")
        return

    print("To move into the dotfiles:")
    for h, _ in movable:
        print("   ", h)
    if dry:
        return
    if not assume_yes:
        if input("Proceed? [Y/n] ").strip().lower() in ("n", "no"):
            return

    # In the repo: replace namesake blocks, append new ones at the end.
    # Array tables ([[x]]) can repeat: they are moved as a group.
    gruppi = {}
    for h, b in movable:
        gruppi.setdefault(h, []).append(b)

    risultato, visti = [], set()
    for h, b in sh_blocks:
        if h in gruppi:
            if h not in visti:
                # A regular table is merged key by key; array tables ([[x]])
                # repeat and have no comparable keys, so the whole group is
                # replaced.
                if h.startswith("[[") or len(gruppi[h]) > 1:
                    risultato += [(h, x) for x in gruppi[h]]
                else:
                    risultato.append((h, unisci(b, gruppi[h][0])))
                visti.add(h)
        else:
            risultato.append((h, b))
    for h, bs in gruppi.items():
        if h not in visti:
            risultato += [(h, x) for x in bs]
            visti.add(h)

    restano = [(h, b) for h, b in st_blocks
               if any(p.match(h) for p in LOCAL)] + trattenuti

    prima = subprocess.run(["noctalia", "config", "export", "full"],
                           capture_output=True, text=True).stdout

    shutil.copy2(STATE, str(STATE) + ".bak-sync")
    shutil.copy2(SHARED, str(SHARED) + ".bak-sync")
    SHARED.write_text("\n".join(pre_shared).rstrip("\n") + "\n\n" + render(risultato))
    STATE.write_text("\n".join(x for x in pre_state if x.strip()) + "\n\n" + render(restano))

    for f in (STATE, SHARED):
        tomllib.loads(f.read_text())

    dopo = subprocess.run(["noctalia", "config", "export", "full"],
                          capture_output=True, text=True).stdout
    if prima and prima != dopo:
        print("WARNING: the effective configuration changed. Restoring backups.",
              file=sys.stderr)
        shutil.copy2(str(STATE) + ".bak-sync", STATE)
        shutil.copy2(str(SHARED) + ".bak-sync", SHARED)
        sys.exit(1)

    print(f"moved {len(movable)} blocks; effective configuration unchanged")
    print("remember to commit the dotfiles")


if __name__ == "__main__":
    main()
