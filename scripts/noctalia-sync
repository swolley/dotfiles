#!/usr/bin/env python3
"""Sposta nei dotfiles le impostazioni di noctalia fatte dall'interfaccia.

La shell scrive sempre in ~/.local/state/noctalia/settings.toml, che ha la
precedenza sul config.toml condiviso. Questo script sposta nel repo i blocchi
portabili e lascia nello stato solo quelli legati a questa macchina.

Uso:
  noctalia-sync            mostra cosa sposterebbe e chiede conferma
  noctalia-sync --dry-run  mostra e basta
  noctalia-sync --yes      sposta senza chiedere
"""
import re
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

STATE = Path.home() / ".local/state/noctalia/settings.toml"
SHARED = Path.home() / ".config/noctalia/config.toml"

# Blocchi che restano locali: nomi dei monitor, geometrie calcolate sulla
# risoluzione, sfondi correnti, impostazioni per singolo plugin con percorsi.
LOCAL = [
    re.compile(r"^\s*\[bar\.[a-z_]+\.monitor\."),
    re.compile(r"^\s*\[dock\.monitor\."),
    re.compile(r"^\s*\[lockscreen_widgets"),
    re.compile(r"^\s*\[notification\]"),
    re.compile(r"^\s*\[osd\]"),
    re.compile(r"^\s*\[wallpaper\.(last|monitors)"),
]
# Chiavi che restano locali pur stando in un blocco portabile: la fila di
# icone appuntate sulla dock dipende da cosa e' installato su questa macchina,
# mentre il resto di [dock] (dimensioni, comportamento) si condivide.
LOCAL_KEYS = {
    "[dock]": {"pinned"},
}
HEADER = re.compile(r"^\s*\[")


def blocks(text):
    """Spezza un TOML in (preambolo, [(intestazione, righe), ...])."""
    pre, out, cur = [], [], None
    for line in text.split("\n"):
        if HEADER.match(line):
            if cur:
                out.append(cur)
            cur = [line]
        elif cur is None:
            pre.append(line)
        else:
            cur.append(line)
    if cur:
        out.append(cur)
    return pre, [(b[0].strip(), b) for b in out]


def render(bs):
    out = []
    for _, b in bs:
        b = list(b)
        while b and not b[-1].strip():
            b.pop()
        out += b + [""]
    return "\n".join(out).rstrip("\n") + "\n"


KEY = re.compile(r"^\s*([A-Za-z0-9_.\"'-]+)\s*=")


def voci(blocco):
    """Spezza il corpo di un blocco in voci (chiave, righe).

    Commenti e righe vuote si attaccano alla chiave che precedono, cosi' una
    chiave sostituita si porta dietro il proprio commento. Le chiavi col valore
    su piu' righe (array) si riconoscono contando le parentesi ancora aperte.
    """
    out, buf, sospese, chiave, aperte = [], [], [], None, 0
    for riga in blocco[1:]:
        commento = riga.lstrip().startswith("#")
        if aperte == 0 and (commento or not riga.strip()):
            sospese.append(riga)
            continue
        if aperte == 0 and KEY.match(riga):
            if buf:
                out.append((chiave, buf))
            buf, chiave = sospese + [riga], KEY.match(riga).group(1)
        else:
            buf += sospese + [riga]
        sospese = []
        if not commento:
            aperte += riga.count("[") - riga.count("]")
    if buf:
        out.append((chiave, buf))
    if sospese:
        out.append((None, sospese))
    return out


def rientra(righe, da, a):
    """Riallinea un blocco di righe dal rientro `da` a quello `a`.

    Lo stato scrive le tabelle annidate senza rientro, il repo le tiene
    indentate: senza questo ogni sincronizzazione appiattirebbe il file.
    """
    if da == a:
        return righe
    return [a + r[len(da):] if r.startswith(da) else r for r in righe]


def spazi(riga):
    return riga[: len(riga) - len(riga.lstrip())]


def unisci(repo, stato):
    """Fonde un blocco del repo con l'omonimo dello stato.

    Lo stato vince sulle chiavi che definisce, ma le chiavi presenti solo nel
    repo vanno conservate: sostituire il blocco intero le perderebbe, e la
    configurazione effettiva cambierebbe.
    """
    da_stato = {k: righe for k, righe in voci(stato) if k is not None}
    fuso, usate = [repo[0]], set()
    for k, righe in voci(repo):
        if k is not None and k in da_stato:
            fuso += rientra(da_stato[k], spazi(da_stato[k][0]), spazi(righe[0]))
            usate.add(k)
        else:
            fuso += righe
    for k, righe in voci(stato):
        if k is not None and k not in usate:
            fuso += righe
    return fuso


def separa(header, blocco):
    """Divide un blocco in (da spostare, da lasciare nello stato).

    Serve ai blocchi che si condividono per quasi tutto tranne qualche chiave:
    quelle elencate in LOCAL_KEYS restano dove la shell le ha scritte.
    """
    locali = LOCAL_KEYS.get(header)
    if not locali:
        return blocco, None
    tieni, sposta = [blocco[0]], [blocco[0]]
    for k, righe in voci(blocco):
        (tieni if k in locali else sposta).extend(righe)
    return (sposta if len(sposta) > 1 else None,
            tieni if len(tieni) > 1 else None)


def main():
    args = sys.argv[1:]
    dry = "--dry-run" in args or "-n" in args
    assume_yes = "--yes" in args or "-y" in args

    for f in (STATE, SHARED):
        if not f.exists():
            sys.exit(f"manca {f}")
    if ".dotfiles" not in SHARED.resolve().parts:
        print(f"nota: {SHARED} non risolve nei dotfiles", file=sys.stderr)

    pre_state, st_blocks = blocks(STATE.read_text())
    pre_shared, sh_blocks = blocks(SHARED.read_text())

    movable, trattenuti = [], []
    for h, b in st_blocks:
        if any(p.match(h) for p in LOCAL):
            continue
        sposta, tieni = separa(h, b)
        if sposta:
            movable.append((h, sposta))
        if tieni:
            trattenuti.append((h, tieni))
    if not movable:
        print("niente da spostare: lo stato contiene solo impostazioni di questa macchina")
        return

    print("Da spostare nei dotfiles:")
    for h, _ in movable:
        print("   ", h)
    if dry:
        return
    if not assume_yes:
        if input("Procedo? [S/n] ").strip().lower() in ("n", "no"):
            return

    # Nel repo: sostituisce i blocchi omonimi, aggiunge i nuovi in coda.
    # Le tabelle di array ([[x]]) possono ripetersi: si spostano come gruppo.
    gruppi = {}
    for h, b in movable:
        gruppi.setdefault(h, []).append(b)

    risultato, visti = [], set()
    for h, b in sh_blocks:
        if h in gruppi:
            if h not in visti:
                # Una tabella normale si fonde chiave per chiave; le tabelle di
                # array ([[x]]) si ripetono e non hanno chiavi confrontabili,
                # quindi si sostituisce il gruppo per intero.
                if h.startswith("[[") or len(gruppi[h]) > 1:
                    risultato += [(h, x) for x in gruppi[h]]
                else:
                    risultato.append((h, unisci(b, gruppi[h][0])))
                visti.add(h)
        else:
            risultato.append((h, b))
    for h, bs in gruppi.items():
        if h not in visti:
            risultato += [(h, x) for x in bs]
            visti.add(h)

    restano = [(h, b) for h, b in st_blocks
               if any(p.match(h) for p in LOCAL)] + trattenuti

    prima = subprocess.run(["noctalia", "config", "export", "full"],
                           capture_output=True, text=True).stdout

    shutil.copy2(STATE, str(STATE) + ".bak-sync")
    shutil.copy2(SHARED, str(SHARED) + ".bak-sync")
    SHARED.write_text("\n".join(pre_shared).rstrip("\n") + "\n\n" + render(risultato))
    STATE.write_text("\n".join(x for x in pre_state if x.strip()) + "\n\n" + render(restano))

    for f in (STATE, SHARED):
        tomllib.loads(f.read_text())

    dopo = subprocess.run(["noctalia", "config", "export", "full"],
                          capture_output=True, text=True).stdout
    if prima and prima != dopo:
        print("ATTENZIONE: la configurazione effettiva e' cambiata. Ripristino i backup.",
              file=sys.stderr)
        shutil.copy2(str(STATE) + ".bak-sync", STATE)
        shutil.copy2(str(SHARED) + ".bak-sync", SHARED)
        sys.exit(1)

    print(f"spostati {len(movable)} blocchi; configurazione effettiva invariata")
    print("ricordati di committare i dotfiles")


if __name__ == "__main__":
    main()
