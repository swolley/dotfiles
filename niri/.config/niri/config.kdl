// Niri config — stow package `niri`
// Inspired by https://github.com/prasangeet/endeavouros-niri (not a fork).
// Soft noctalia green accents match starship / tmux / kitty / nvim.
//
// After install: log into a Niri session, then run `niri msg outputs` and
// uncomment/edit the output block below for your monitor.

prefer-no-csd

// noctalia v5 integra polkit agent, wallpaper daemon, idle manager e lock
// screen: niente helper esterni (erano polkit-gnome, swaybg, swayidle).
// Per riattivarli: config.kdl.bak-v4-quickshell.

spawn-at-startup "xwayland-satellite"

// Shell UI (bar/dock/launcher/notifiche/lock).
// Lo script avvia noctalia e, se muore, apre una kitty con le ultime righe
// di log e scrive sul journal. NON usa notify-send: in v5 il demone di
// notifica e' noctalia stesso, quindi non puo' annunciare il proprio
// fallimento e ti ritroveresti col desktop vuoto senza spiegazione.
spawn-sh-at-startup "$HOME/.config/niri/start-noctalia.sh"

// Convenience: open a terminal on login (also Ctrl+Alt+T / Super+Return)
// Non serve piu' come rete di sicurezza: se ne occupa start-noctalia.sh.
spawn-sh-at-startup "$HOME/.config/niri/terminal.sh focus"

environment {
    QT_QPA_PLATFORM "wayland"
    XWAYLAND "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"

    // Do NOT force Intel iris here — this config is shared across machines.
    // On Intel-only boxes you may optionally set:
    // MESA_LOADER_DRIVER_OVERRIDE "iris"
    // GBM_BACKEND "iris"
}

input {
    keyboard {
        repeat-delay 200
        repeat-rate 35
        xkb {
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
    }

    trackpoint {
    }

    focus-follows-mouse
}

overview {
    // Fallback tint; Noctalia wallpaper sits in the backdrop via layer-rule below.
    backdrop-color "#1c1c1e"
}

// Stationary Noctalia wallpaper visible in overview (docs: compositor-settings/niri).
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}

cursor {
    // Same cursor family as GNOME (org.gnome.desktop.interface cursor-theme)
    xcursor-theme "Qogir"
    xcursor-size 24
}

// Per-machine monitors live in outputs.local.kdl (see README).
// Empty file = niri auto-places outputs (safe default for shared dots).
include "./outputs.local.kdl"


layout {
    // Let Noctalia wallpaper show through (pair with noctalia-wallpaper layer-rule).
    background-color "transparent"

    gaps 10

    center-focused-column "on-overflow"

    // Con una sola finestra aperta la tiene al centro invece che a sinistra:
    // riduce lo spaesamento arrivando da un desktop tradizionale.
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 2
        // Overridden by noctalia.kdl include, kept as fallback
        active-color "#8fbf98"
        inactive-color "#3a3b3e"
    }

    shadow {
        off
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }
}

hotkey-overlay {
    // skip-at-startup
}

screenshot-path "~/Immagini/Schermate/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    draw-border-with-background false
}

window-rule {
    match is-active=false
    opacity 0.90
}

window-rule {
    match is-active=true
    opacity 0.95
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

workspace "c" {
}

workspace "b" {
}

workspace "a" {
}

window-rule {
    match title="Firefox"
    open-on-workspace "c"
    open-maximized true
}

/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

// Floating Noctalia settings window (official niri compositor settings).
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // File manager: Nautilus (GNOME) — switch to dolphin later if desired
    Mod+E {
        spawn-sh "nautilus";
    }

    Mod+Alt+Space hotkey-overlay-title="Toggle floating window" {
        toggle-window-floating;
    }

    // Terminal (GNOME-style Ctrl+Alt+T + tiling Mod+Return)
    // Terminale unico: se c'e' gia' una kitty le da' il focus.
    Ctrl+Alt+T       { spawn-sh "$HOME/.config/niri/terminal.sh focus"; }
    Mod+Return       { spawn-sh "$HOME/.config/niri/terminal.sh focus"; }
    Mod+Shift+Return { spawn-sh "$HOME/.config/niri/terminal.sh new"; }

    Mod+F {
        maximize-column;
    }

    // Noctalia v5 IPC: https://docs.noctalia.dev/noctalia/ipc/
    Mod+D {
        spawn-sh "noctalia msg panel-toggle launcher";
    }

    Mod+L {
        spawn-sh "noctalia msg session lock";
    }

    Mod+Shift+L {
        spawn-sh "noctalia msg session lock-and-suspend";
    }

    Mod+X {
        toggle-overview;
    }

    Mod+Shift+F {
        fullscreen-window;
    }

    Super+Alt+S allow-when-locked=true {
        spawn-sh "pkill orca || exec orca";
    }

    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-up";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-down";
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "noctalia msg volume-mute";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "noctalia msg mic-mute";
    }

    XF86AudioPlay { spawn-sh "noctalia msg media toggle"; }
    XF86AudioNext { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev { spawn-sh "noctalia msg media previous"; }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn-sh "noctalia msg brightness-up || brightnessctl s +10%";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn-sh "noctalia msg brightness-down || brightnessctl s 10%-";
    }

    Mod+N {
        spawn-sh "noctalia msg nightlight-toggle";
    }

    Mod+V {
        spawn-sh "noctalia msg panel-toggle clipboard";
    }

    Mod+Period {
        spawn-sh "noctalia msg panel-toggle launcher /emo";
    }

    Mod+C {
        spawn-sh "noctalia msg panel-toggle control-center";
    }

    Mod+M {
        spawn-sh "noctalia msg panel-toggle control-center audio";
    }

    Mod+S {
        spawn-sh "noctalia msg settings-toggle";
    }

    Mod+Shift+J {
        spawn-sh "noctalia msg bar-toggle";
    }

    Mod+O {
        spawn-sh "noctalia msg dock-toggle";
    }

    Mod+G {
        spawn-sh "noctalia msg desktop-widgets-toggle";
    }

    Mod+W {
        spawn-sh "noctalia msg wifi-toggle";
    }

    Mod+Shift+W {
        spawn-sh "noctalia msg panel-toggle control-center network";
    }

    Mod+B {
        spawn-sh "noctalia msg bluetooth-toggle";
    }

    Mod+Shift+B {
        spawn-sh "noctalia msg panel-toggle control-center bluetooth";
    }

    Mod+Shift+D {
        spawn-sh "noctalia msg notification-dnd-toggle";
    }

    Mod+Shift+BackSpace {
        spawn-sh "noctalia msg notification-clear-active";
    }

    Mod+T {
        spawn-sh "noctalia msg theme-mode-toggle";
    }

    Mod+Ctrl+T {
        spawn-sh "noctalia msg panel-toggle wallpaper";
    }

    Mod+Ctrl+Alt+T {
        spawn-sh "noctalia msg wallpaper-random";
    }

    // Mod+A e' libero: era `wallpaper toggleAutomation` di noctalia v4,
    // senza equivalente in v5.

    // Larghezza colonne: preset 1/3, 1/2, 2/3 (vedi preset-column-widths)
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus   { set-column-width "-10%"; }
    Mod+plus    { set-column-width "+10%"; }  // layout it: + e' un tasto diretto, = e' Shift+0
    Mod+Ctrl+F  { expand-column-to-available-width; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    // Monitor: LG a sinistra, portatile a destra, striscia BOE sotto il portatile
    Mod+Shift+Left       { focus-monitor-left; }
    Mod+Shift+Right      { focus-monitor-right; }
    Mod+Shift+Up         { focus-monitor-up; }
    Mod+Shift+Down       { focus-monitor-down; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }

    Mod+Q repeat=false { close-window; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Shift+S { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Escape allow-inhibiting=false {
        toggle-keyboard-shortcuts-inhibit;
    }

    Ctrl+Alt+Delete { spawn-sh "noctalia msg panel-toggle session"; }
}



include "noctalia.kdl"
