// Include monitor configuration generated by nwg-displays
include "monitor.kdl"

// Niri config — stow package `niri`
// Inspired by https://github.com/prasangeet/endeavouros-niri (not a fork).
// Soft noctalia green accents match starship / tmux / kitty / nvim.
//
// After install: log into a Niri session, then run `niri msg outputs` and
// uncomment/edit the output block below for your monitor.

prefer-no-csd

// noctalia v5 integrates the polkit agent, wallpaper daemon, idle manager and
// lock screen: no external helpers (they used to be polkit-gnome, swaybg,
// swayidle). To re-enable them: config.kdl.bak-v4-quickshell.

spawn-at-startup "xwayland-satellite"

// Shell UI (bar/dock/launcher/notifiche/lock).
// The script starts noctalia and, if it dies, opens a kitty with the last log
// lines and writes to the journal. It does NOT use notify-send: in v5 the
// notification daemon is noctalia itself, so it cannot announce its own
// failure and you would be left with an empty desktop and no explanation.
spawn-sh-at-startup "$HOME/.config/niri/start-noctalia.sh"

// Notify if the dotfiles repo has commits to pull (fetch only).
spawn-sh-at-startup "$HOME/.dotfiles/scripts/dotfiles-updates"

// No terminal at login: you open it when needed with Ctrl+Alt+T or
// Super+Return. It was no longer needed as a safety net, start-noctalia.sh
// takes care of that.
// spawn-sh-at-startup "$HOME/.config/niri/terminal.sh focus"

environment {
    QT_QPA_PLATFORM "wayland"
    // Non-KDE Qt apps have nobody to give them a palette: without this line
    // they stay on the factory light theme. qt6ct reads the colors that
    // noctalia generates in ~/.config/qt6ct/colors/. KDE apps do not use it,
    // they take their colors from ~/.config/kdeglobals.
    QT_QPA_PLATFORMTHEME "qt6ct"
    XWAYLAND "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"

    // OpenSSH user agent (systemd --user ssh-agent.socket).
    // Needed by DBeaver/GUI apps: Niri does not inherit this from GNOME.
    SSH_AUTH_SOCK "/run/user/1000/ssh-agent.socket"

    // Do NOT force Intel iris here — this config is shared across machines.
    // On Intel-only boxes you may optionally set:
    // MESA_LOADER_DRIVER_OVERRIDE "iris"
    // GBM_BACKEND "iris"
}

input {
    keyboard {
        repeat-delay 350
        repeat-rate 35
        xkb {
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
    }

    trackpoint {
    }

    // Focus changes only on click. With focus-follows-mouse the strip scrolls
    // by itself when the pointer touches the edge or crosses to another
    // monitor, and it gets tiring after a while. niri has no delay, only
    // max-scroll-amount. To try it again: uncomment.
    // focus-follows-mouse max-scroll-amount="0%"
}

gestures {
    // No overview when moving the mouse into the top-left corner: it was
    // triggered by accident. It stays on Mod+X and as the second step of Mod+D.
    hot-corners {
        off
    }
}

overview {
    // Fallback tint; Noctalia wallpaper sits in the backdrop via layer-rule below.
    backdrop-color "#1c1c1e"

    // An outline around every workspace: without it, empty workspaces blend
    // into the background in the overview and you cannot tell how many there
    // are. softness at zero: solid border, no blur. The corners stay sharp,
    // niri does not expose a radius.
    workspace-shadow {
        softness 0
        spread 3
        offset x=0 y=0
        color "#8fbf98cc"
    }
}

// Stationary Noctalia wallpaper visible in overview (docs: compositor-settings/niri).
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}

cursor {
    // Personal preference kept here temporarily; final decision (move it to a
    // local/override file or keep it as the default) is deferred.
    // Same cursor family as GNOME (org.gnome.desktop.interface cursor-theme)
    xcursor-theme "Qogir"
    xcursor-size 24
}

// Per-machine monitors live in outputs.local.kdl (see README).
// Empty file = niri auto-places outputs (safe default for shared dots).
include "./outputs.local.kdl"


layout {
    // Let Noctalia wallpaper show through (pair with noctalia-wallpaper layer-rule).
    background-color "transparent"

    gaps 10

    center-focused-column "on-overflow"

    // With a single window open, keep it centered instead of on the left:
    // it reduces disorientation when coming from a traditional desktop.
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 2
        // Overridden by noctalia.kdl include, kept as fallback
        active-color "#8fbf98"
        inactive-color "#3a3b3e"
    }

    shadow {
        off
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }
}

hotkey-overlay {
    skip-at-startup
}

// Regular screenshots are taken by noctalia, which saves to the user's
// Pictures folder. niri's built-in one (Ctrl+Print, fallback) does not know
// the XDG folders: I keep it clipboard-only, without writing files.
screenshot-path null

animations {
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    draw-border-with-background false
}

window-rule {
    match is-active=false
    opacity 0.90
}

window-rule {
    match is-active=true
    opacity 0.95
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// niri workspaces are created and destroyed automatically: there is always an
// empty one at the end of each monitor, and the others live as long as they
// contain windows. The trailing empty one cannot be removed, so the minimum
// is one full plus one empty; the strip, which stays without windows, keeps
// just one precisely because it has no named workspace pinning it at two.
//
// No named workspaces: a name replaces the number in the bar, and here it
// adds nothing. Firefox is anchored to the monitor, not to the workspace.

// Personal preference kept here temporarily; final decision (move it to a
// local/override file or keep it as the default) is deferred.
// Firefox opens on the big built-in screen, on its first workspace.
// Moving it by hand is still possible: the rule only applies on open.
// (No Teams/Outlook-specific window rules exist in this config.)
window-rule {
    match app-id=r#"^firefox$"#
    open-on-output "eDP-1"
    open-maximized true
}

/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Floating Noctalia settings window (official niri compositor settings).
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Login window of NetworkManager's OpenConnect VPNs (password, 2FA code,
// SSO): a centered popup instead of a full-height column.
window-rule {
    match app-id="^nm-openconnect-auth-dialog$"
    open-floating true
    default-column-width { fixed 560; }
    default-window-height { fixed 680; }
}

// Network connection editor (editing VPNs, wifi, etc.).
window-rule {
    match app-id="^nm-connection-editor$"
    open-floating true
    default-column-width { fixed 640; }
    default-window-height { fixed 720; }
}

// "Open file" / "Open folder" / "Save as" windows: opened by the GTK portal
// on behalf of any app. Centered popup instead of a full column.
window-rule {
    match app-id="^xdg-desktop-portal-gtk$"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 640; }
}

debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // File manager: Nautilus (GNOME) — switch to dolphin later if desired
    Mod+E {
        spawn-sh "nautilus";
    }

    Mod+Space hotkey-overlay-title="Toggle floating window" {
        toggle-window-floating;
    }

    // Terminal (GNOME-style Ctrl+Alt+T + tiling Mod+Return)
    // Single terminal: if a kitty already exists, it gets the focus.
    Ctrl+Alt+T       { spawn-sh "$HOME/.config/niri/terminal.sh focus"; }
    Mod+Return       { spawn-sh "$HOME/.config/niri/terminal.sh focus"; }
    Mod+Shift+Return { spawn-sh "$HOME/.config/niri/terminal.sh new"; }

    Mod+F {
        maximize-column;
    }

    // Like on GNOME: first press opens the launcher, second the window
    // overview, third closes it.
    // Noctalia v5 IPC: https://docs.noctalia.dev/noctalia/ipc/
    Mod+D {
        spawn-sh "$HOME/.config/niri/launcher.sh";
    }

    Mod+L {
        spawn-sh "noctalia msg session lock";
    }

    Mod+Shift+L {
        spawn-sh "noctalia msg session lock-and-suspend";
    }

    Mod+X {
        toggle-overview;
    }

    Mod+Shift+F {
        fullscreen-window;
    }

    Super+Alt+S allow-when-locked=true {
        spawn-sh "pkill orca || exec orca";
    }

    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-up";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-down";
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "noctalia msg volume-mute";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "noctalia msg mic-mute";
    }

    // noctalia handles these: it follows whichever player is active at the
    // moment, so the key reaches whoever is really playing. I tried giving
    // Tidal priority with playerctl and --player=tidal-hifi,%any, but then
    // Tidal grabbed the keys even while paused, while a video was playing
    // elsewhere.
    XF86AudioPlay { spawn-sh "noctalia msg media toggle"; }
    XF86AudioNext { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev { spawn-sh "noctalia msg media previous"; }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn-sh "noctalia msg brightness-up || brightnessctl s +10%";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn-sh "noctalia msg brightness-down || brightnessctl s 10%-";
    }

    // Special keys of the keyboard (multimedia/office row).
    XF86HomePage { spawn-sh "firefox"; }
    XF86WWW      { spawn-sh "firefox"; }
    // Personal preference kept here temporarily; final decision (move it to a
    // local/override file or keep it as the default) is deferred.
    XF86Mail     { spawn-sh "gtk-launch outlook-for-linux"; }
    XF86Calculator { spawn-sh "gnome-calculator"; }
    XF86Explorer   { spawn-sh "nautilus"; }
    XF86MyComputer { spawn-sh "nautilus"; }
    XF86Search     { spawn-sh "$HOME/.config/niri/launcher.sh"; }
    XF86Sleep      { spawn-sh "noctalia msg session lock"; }
    // Personal preference kept here temporarily; final decision (move it to a
    // local/override file or keep it as the default) is deferred.
    // Fn+F5: on the keyboard this is the settings key, which the kernel
    // reports as KEY_CONFIG and xkb translates to XF86Tools. There is nothing
    // to configure here, so I use it for Tidal. tidal-hifi keeps a single
    // instance: if it is already open, relaunching it brings the window up.
    XF86Tools      { spawn-sh "gtk-launch tidal-hifi"; }
    // The power key opens the session menu (lock, suspend, logout, reboot,
    // shutdown) instead of powering off at once.
    XF86PowerOff   { spawn-sh "noctalia msg panel-toggle session"; }

    Mod+N {
        spawn-sh "noctalia msg nightlight-toggle";
    }

    Mod+V {
        spawn-sh "noctalia msg panel-toggle clipboard";
    }

    Mod+Period {
        spawn-sh "noctalia msg panel-toggle launcher /emo";
    }

    Mod+C {
        spawn-sh "noctalia msg panel-toggle control-center";
    }

    Mod+M {
        spawn-sh "noctalia msg panel-toggle control-center audio";
    }

    Mod+S {
        spawn-sh "noctalia msg settings-toggle";
    }

    Mod+Shift+J {
        spawn-sh "noctalia msg bar-toggle";
    }

    Mod+O {
        spawn-sh "noctalia msg dock-toggle";
    }

    Mod+G {
        spawn-sh "noctalia msg desktop-widgets-toggle";
    }

    Mod+W {
        spawn-sh "noctalia msg wifi-toggle";
    }

    Mod+Shift+W {
        spawn-sh "noctalia msg panel-toggle control-center network";
    }

    Mod+B {
        spawn-sh "noctalia msg bluetooth-toggle";
    }

    Mod+Shift+B {
        spawn-sh "noctalia msg panel-toggle control-center bluetooth";
    }

    Mod+Shift+D {
        spawn-sh "noctalia msg notification-dnd-toggle";
    }

    Mod+Shift+BackSpace {
        spawn-sh "noctalia msg notification-clear-active";
    }

    Mod+T {
        spawn-sh "noctalia msg theme-mode-toggle";
    }

    Mod+Ctrl+T {
        spawn-sh "noctalia msg panel-toggle wallpaper";
    }

    Mod+Ctrl+Alt+T {
        spawn-sh "noctalia msg wallpaper-random";
    }

    // Mod+A is free: it was noctalia v4's `wallpaper toggleAutomation`,
    // with no equivalent in v5.

    // Column width: presets 1/3, 1/2, 2/3 (see preset-column-widths)
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    // Italian layout: + is a direct key, = is Shift+0. Same commands on the keypad.
    Mod+Minus       { set-column-width "-10%"; }
    Mod+plus        { set-column-width "+10%"; }
    Mod+KP_Subtract { set-column-width "-10%"; }
    Mod+KP_Add      { set-column-width "+10%"; }
    Mod+Ctrl+F  { expand-column-to-available-width; }

    // Height: only has an effect when the column contains several stacked
    // windows, because a single window already fills the whole height.
    Mod+Shift+Minus       { set-window-height "-10%"; }
    Mod+Shift+plus        { set-window-height "+10%"; }
    Mod+Shift+KP_Subtract { set-window-height "-10%"; }
    Mod+Shift+KP_Add      { set-window-height "+10%"; }
    Mod+Ctrl+R            { switch-preset-window-height; }
    Mod+Ctrl+Shift+R      { reset-window-height; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    // Mod+wheel: scrolls the strip of columns without having to click, now
    // that focus no longer follows the mouse. Ctrl+wheel changes workspace.
    Mod+WheelScrollDown      cooldown-ms=100 { focus-column-right; }
    Mod+WheelScrollUp        cooldown-ms=100 { focus-column-left; }
    Mod+WheelScrollRight     cooldown-ms=100 { focus-column-right; }
    Mod+WheelScrollLeft      cooldown-ms=100 { focus-column-left; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    // Same action from the keyboard. Mod+Ctrl+Up/Down already belong to
    // move-window-*, so Page Up/Down are used, as in niri's default config.
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    // Monitors: LG on the left, laptop on the right, BOE strip below the laptop
    Mod+Shift+Left       { focus-monitor-left; }
    Mod+Shift+Right      { focus-monitor-right; }
    Mod+Shift+Up         { focus-monitor-up; }
    Mod+Shift+Down       { focus-monitor-down; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }

    Mod+Q repeat=false { close-window; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // noctalia screenshots, like on GNOME: they save to the user's Pictures folder (XDG).
    // Print = full screen, Alt+Print = active window, Shift+Print = area.
    Print       { spawn-sh "noctalia msg screenshot-fullscreen"; }
    Alt+Print   { spawn-sh "noctalia msg screenshot-window"; }
    Shift+Print { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Shift+S { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Shift+A { spawn-sh "noctalia msg screenshot-annotate"; }
    // screen-toolkit panel: OCR, QR, palette, color picker, recording.
    Mod+Print   { spawn-sh "noctalia msg panel-toggle alexander/screen-toolkit:panel"; }
    // niri's built-in fallback, if the shell is not running.
    Ctrl+Print  { screenshot-screen; }

    Mod+Escape allow-inhibiting=false {
        toggle-keyboard-shortcuts-inhibit;
    }

    Ctrl+Alt+Delete { spawn-sh "noctalia msg panel-toggle session"; }
}



include "noctalia.kdl"
