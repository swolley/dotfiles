// Niri config — stow package `niri`
// Inspired by https://github.com/prasangeet/endeavouros-niri (not a fork).
// Soft noctalia green accents match starship / tmux / kitty / nvim.
//
// After install: log into a Niri session, then run `niri msg outputs` and
// uncomment/edit the output block below for your monitor.

prefer-no-csd

// Polkit agent (GNOME legacy — installed by install-niri.sh as polkit-gnome)
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// Wallpaper: prefer ~/Immagini/Firefox_wallpaper.png, else solid soft background
spawn-sh-at-startup "swaybg -i \"$HOME/Immagini/Firefox_wallpaper.png\" -m fill 2>/dev/null || swaybg -c '#1c1c1e'"

spawn-at-startup "xwayland-satellite"

spawn-at-startup "swayidle" "-w" \
    "timeout" "300" "qs -c noctalia-shell ipc call lockScreen lock" \
    "timeout" "600" "systemctl suspend" \
    "before-sleep" "qs -c noctalia-shell ipc call lockScreen lock"

spawn-at-startup "qs" "-c" "noctalia-shell"

environment {
    QT_QPA_PLATFORM "wayland"
    XWAYLAND "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"

    // Intel (Meteor Lake) — do NOT set NVIDIA GBM/GLX vars on this machine
    MESA_LOADER_DRIVER_OVERRIDE "iris"
    GBM_BACKEND "iris"
}

input {
    keyboard {
        repeat-delay 200
        repeat-rate 35
        xkb {
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
    }

    trackpoint {
    }

    focus-follows-mouse
}

overview {
    backdrop-color "#1c1c1e"
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

cursor {
    // Same cursor family as GNOME (org.gnome.desktop.interface cursor-theme)
    xcursor-theme "Qogir"
    xcursor-size 24
}

// Uncomment and adjust after: niri msg outputs
/-output "eDP-1" {
    // mode "1920x1080@60"
    // scale 1
    transform "normal"
}

layout {
    gaps 10

    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 2
        // Overridden by noctalia.kdl include, kept as fallback
        active-color "#8fbf98"
        inactive-color "#3a3b3e"
    }

    shadow {
        off
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }
}

hotkey-overlay {
    // skip-at-startup
}

screenshot-path "~/Immagini/Schermate/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    draw-border-with-background false
}

window-rule {
    match is-active=false
    opacity 0.90
}

window-rule {
    match is-active=true
    opacity 0.95
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

workspace "c" {
}

workspace "b" {
}

workspace "a" {
}

window-rule {
    match title="Firefox"
    open-on-workspace "c"
    open-maximized true
}

/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // File manager: Nautilus (GNOME) — switch to dolphin later if desired
    Mod+E {
        spawn-sh "nautilus";
    }

    Mod+Alt+Space hotkey-overlay-title="Toggle floating window" {
        toggle-window-floating;
    }

    Mod+Return { spawn "kitty"; }

    Mod+F {
        maximize-column;
    }

    Mod+D {
        spawn-sh "qs -c noctalia-shell ipc call launcher toggle";
    }

    Mod+L {
        spawn-sh "qs -c noctalia-shell ipc call lockScreen lock";
    }

    Mod+Shift+L {
        spawn-sh "qs -c noctalia-shell ipc call sessionMenu lockAndSuspend";
    }

    Mod+X {
        toggle-overview;
    }

    Mod+Shift+F {
        fullscreen-window;
    }

    Super+Alt+S allow-when-locked=true {
        spawn-sh "pkill orca || exec orca";
    }

    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "qs -c noctalia-shell ipc call volume increase";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "qs -c noctalia-shell ipc call volume decrease";
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "qs -c noctalia-shell ipc call volume muteOutput";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "qs -c noctalia-shell ipc call volume muteInput";
    }

    XF86AudioPlay { spawn-sh "qs -c noctalia-shell ipc call media playPause"; }
    XF86AudioNext { spawn-sh "qs -c noctalia-shell ipc call media next"; }
    XF86AudioPrev { spawn-sh "qs -c noctalia-shell ipc call media previous"; }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn-sh "qs -c noctalia-shell ipc call brightness increase || brightnessctl s +10%";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn-sh "qs -c noctalia-shell ipc call brightness decrease || brightnessctl s 10%-";
    }

    Mod+N {
        spawn-sh "qs -c noctalia-shell ipc call nightLight toggle";
    }

    Mod+V {
        spawn-sh "qs -c noctalia-shell ipc call launcher clipboard";
    }

    Mod+Period {
        spawn-sh "qs -c noctalia-shell ipc call launcher emoji";
    }

    Mod+C {
        spawn-sh "qs -c noctalia-shell ipc call controlCenter toggle";
    }

    Mod+M {
        spawn-sh "qs -c noctalia-shell ipc call volume togglePanel";
    }

    Mod+S {
        spawn-sh "qs -c noctalia-shell ipc call settings toggle";
    }

    Mod+Shift+J {
        spawn-sh "qs -c noctalia-shell ipc call bar toggle";
    }

    Mod+O {
        spawn-sh "qs -c noctalia-shell ipc call dock toggle";
    }

    Mod+G {
        spawn-sh "qs -c noctalia-shell ipc call desktopWidgets toggle";
    }

    Mod+W {
        spawn-sh "qs -c noctalia-shell ipc call wifi toggle";
    }

    Mod+Shift+W {
        spawn-sh "qs -c noctalia-shell ipc call network togglePanel";
    }

    Mod+B {
        spawn-sh "qs -c noctalia-shell ipc call bluetooth toggle";
    }

    Mod+Shift+B {
        spawn-sh "qs -c noctalia-shell ipc call bluetooth togglePanel";
    }

    Mod+Shift+D {
        spawn-sh "qs -c noctalia-shell ipc call notifications toggleDND";
    }

    Mod+Shift+BackSpace {
        spawn-sh "qs -c noctalia-shell ipc call notifications dismissAll";
    }

    Mod+T {
        spawn-sh "qs -c noctalia-shell ipc call darkMode toggle";
    }

    Mod+Ctrl+T {
        spawn-sh "qs -c noctalia-shell ipc call wallpaper toggle";
    }

    Mod+Ctrl+Alt+T {
        spawn-sh "qs -c noctalia-shell ipc call wallpaper random";
    }

    Mod+A {
        spawn-sh "qs -c noctalia-shell ipc call wallpaper toggleAutomation";
    }

    Mod+Minus {
        spawn-sh "qs -c noctalia-shell ipc call zoom zoomOut";
    }

    Mod+equal {
        spawn-sh "qs -c noctalia-shell ipc call zoom zoomIn";
    }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+Q repeat=false { close-window; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Shift+S { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Escape allow-inhibiting=false {
        toggle-keyboard-shortcuts-inhibit;
    }

    Ctrl+Alt+Delete { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
}

include "./noctalia.kdl"
