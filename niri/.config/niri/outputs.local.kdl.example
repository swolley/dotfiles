// Example monitor blocks for niri — copy what you need into outputs.local.kdl
// Discover names/modes with: niri msg outputs

// Laptop panel
output "eDP-1" {
    mode "1920x1080@60"
    scale 1
    transform "normal"
}

// External monitor to the right of eDP-1 (adjust x to the logical width of eDP-1)
output "HDMI-A-1" {
    mode "2560x1440@60"
    scale 1
    position x=1920 y=0
}

// Another common connector name
/-output "DP-1" {
    mode "3840x2160@60"
    scale 2
    position x=0 y=0
}
