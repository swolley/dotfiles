// Soft noctalia green — aligned with starship / tmux / kitty / nvim
layout {
    focus-ring {
        active-color   "#8fbf98"
        inactive-color "#1c1c1e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#8fbf98"
        inactive-color "#3a3b3e"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#8fbf98"
        inactive-color "#2a2b2e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#8fbf9880"
    }
}

recent-windows {
    highlight {
        active-color "#8fbf98"
        urgent-color "#ffb4ab"
    }
}
