layout {

    focus-ring {
        active-color   "#8fbf98"
        inactive-color "#222226"
        urgent-color   "#c01c28"
    }

    border {
        active-color   "#8fbf98"
        inactive-color "#222226"
        urgent-color   "#c01c28"
    }


    tab-indicator {
        active-color   "#8fbf98"
        inactive-color "#425148"
        urgent-color   "#c01c28"
    }

    insert-hint {
        color "#8fbf9880"
    }
}

recent-windows {
    highlight {
        active-color "#8fbf98"
        urgent-color "#c01c28"
    }
}
