#!/bin/sh
# Opens GParted as root while staying on wayland.
#
# The system launcher elevates itself with pkexec, which cleans the environment
# and lets only DISPLAY through: root therefore ends up on xwayland. There no
# window manager publishes _NET_WORKAREA, GTK does not know how much space it
# has and shortens the menus by adding scroll arrows.
#
# By passing the wayland socket by hand, GParted talks to it directly: correct
# scaling and full menus. The dark theme is not forced here: it is taken from
# /root/.config/gtk-3.0/settings.ini, which setup-machine.sh writes.
#
# /usr/bin/gparted is invoked and not the binary: that script, when it already
# runs as root, masks the mount units to prevent automount during the
# operations. Skipping it would be dangerous.
exec pkexec env \
  WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
  XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
  GDK_BACKEND=wayland \
  /usr/bin/gparted "$@"
