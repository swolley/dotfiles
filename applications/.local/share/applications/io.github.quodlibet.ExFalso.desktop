[Desktop Entry]
# Ex Falso is the tag editor that ships with Quod Libet: same package, it
# cannot be uninstalled on its own. Tags are fixed with picard, so the entry
# disappears from the launcher while the player stays. NoDisplay hides the icon
# but keeps the file type association, so it can still be opened from nautilus.
Type=Application
Name=Ex Falso
Exec=exfalso %F
Icon=io.github.quodlibet.ExFalso
NoDisplay=true
